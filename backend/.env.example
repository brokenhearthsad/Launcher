# Launcher backend configuration (all optional). Prefix: DML_
# No secrets are needed: Launcher never stores Steam passwords, tokens or Steam Guard codes.

DML_HOST=127.0.0.1
DML_PORT=8000
# SQLite file and backup folder (relative paths are relative to the backend folder)
DML_DATABASE_URL=sqlite:///./data/match_lab.db
DML_BACKUP_DIR=./data/backups

DML_LOG_LEVEL=INFO
DML_DB_LOG_LEVEL=INFO

# Drives shown on the "System" page (JSON list). Missing drives show "Нет данных".
DML_MONITORED_DRIVES=["C:\\", "D:\\"]
# Steam folder, only if automatic detection (registry / default folder) fails:
# DML_STEAM_PATH=D:\Steam

# Opt-in: run the Launcher process itself below normal priority.
# Launcher never changes the priority of other programs.
DML_LOWER_OWN_PRIORITY=false

DML_WS_PUBLISH_HZ=4
DML_API_RATE_LIMIT_PER_MINUTE=600
