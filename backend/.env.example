# Dota 2 Match Lab backend configuration (all optional). Prefix: DML_
# No secrets are needed: the lab never uses Steam accounts or passwords.

DML_HOST=127.0.0.1
DML_PORT=8000
# SQLite file (relative paths are relative to the backend folder)
DML_DATABASE_URL=sqlite:///./data/match_lab.db
DML_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DML_LOG_LEVEL=INFO
DML_DB_LOG_LEVEL=INFO

# Load management
DML_MAX_CONCURRENT_SESSIONS=2
DML_WS_PUBLISH_HZ=4
DML_API_RATE_LIMIT_PER_MINUTE=240

# Simulator defaults (can be changed later on the Settings page)
DML_SIM_TICK_SECONDS=0.5
DML_SIM_DEFAULT_SPEED=20
DML_SIM_MAX_GAME_SECONDS=3600
